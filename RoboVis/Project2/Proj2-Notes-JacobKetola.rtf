def create_controls():\
    cv2.namedWindow(WIN_CTRL)\
    cv2.resizeWindow(WIN_CTRL, 400, 300)\
    # accumulateWeighted alpha = trackbar / 1000 (default 0.02)\
    cv2.createTrackbar("Alpha x1000", WIN_CTRL, 20, 200, nothing)\
    cv2.createTrackbar("Brightness", WIN_CTRL, 20, 100, nothing)\
    cv2.createTrackbar("Threshold 1", WIN_CTRL, 25, 255, nothing)\
    cv2.createTrackbar("Threshold 2", WIN_CTRL, 40, 255, nothing)\
    cv2.createTrackbar("Min area", WIN_CTRL, 1500, 20000, nothing)\
\
def preprocess(frame, brightness):\
    """\
    Brighten slightly, then blur heavily.\
    convertScaleAbs computes |alpha*pixel + beta| and saturates to 0-255 (uint8).\
    Blurring averages out sensor noise and tiny changes, so only larger\
    regions of real change survive the difference step.\
    """\
\
while True:\
        ok, frame = cap.read()\
        if not ok:\
            break\
 \
        alpha, brightness, t1, t2, min_area = read_controls()\
        processed = preprocess(frame, brightness)\
 \
        # Initialize the 32-bit float accumulator on the first frame\
        # accumulateWeighted requires the accumulator (dst) to be float32 or\
        # float64 with the same size and channel count as the source.\
        # Floats are needed because each update adds tiny fractional amounts\
        # (e.g. 0.02 * pixel). In uint8 those fractions would be rounded away\
        # and the average would never change smoothly.\
        if avg is None:\
            avg = processed.astype(np.float32)   # same as np.float32(processed)\
            continue\
 \
        # Convert the float background back to 8-bit\
        # convertScaleAbs rounds, takes absolute value, and saturates to uint8,\
        # giving an image with the same type as the webcam frame.\
        background = cv2.convertScaleAbs(avg)\
 \
        # Difference between current frame and background\
        # absdiff avoids the wrap-around you'd get from subtracting uint8 values.\
        diff = cv2.absdiff(processed, background)\
 \
        #Update the running average \
        # avg = (1 - alpha) * avg + alpha * processed\
        # Small alpha: background adapts slowly (moving things stay "motion" longer).\
        # Large alpha: background adapts quickly (a still person fades into it fast).\
        # This update happens after the difference, so the current frame's\
        # moving object doesn't contaminate the background it's compared to.\
        cv2.accumulateWeighted(processed, avg, alpha)\
 \
        # ---- Grayscale ----\
        gray_diff = cv2.cvtColor(diff, cv2.COLOR_BGR2GRAY)\
 \
        # ---- Threshold -> blur -> threshold ----\
        # First threshold: keep only pixels that changed significantly.\
\
        _, binary = cv2.threshold(gray_diff, t1, 255, cv2.THRESH_BINARY)\
\
        # Blur: merges nearby white fragments of the same object and softens specks.\
\
        binary = cv2.GaussianBlur(binary, (15, 15), 0)\
\
        # Second threshold: turn the blurred mask back into pure black/white.\
\
        _, binary = cv2.threshold(binary, t2, 255, cv2.THRESH_BINARY)\
\
        # Dilate to fill small gaps so one object forms one contour\
        binary = cv2.dilate(binary, None, iterations=2)\
 \
        # ---- Contours ----\
        # RETR_EXTERNAL: only outer boundaries (we don't care about holes).\
        # CHAIN_APPROX_SIMPLE: compress straight segments to save memory.\
        # [-2] makes this work in both OpenCV 3 (3 return values) and 4 (2 values).\
        contours = cv2.findContours(binary, cv2.RETR_EXTERNAL,\
                                    cv2.CHAIN_APPROX_SIMPLE)[-2]\
 \
        contour_vis = np.zeros_like(frame)\
        cv2.drawContours(contour_vis, contours, -1, (128, 128, 128), 1)\
 \
        output = frame.copy()\
        significant = 0\
        for c in contours:\
            # Reject insignificant contours: noise, flicker, single pixels,\
            # and small shadow fragments all produce tiny areas.\
            if cv2.contourArea(c) < min_area:\
                continue\
            significant += 1\
 \
            cv2.drawContours(contour_vis, [c], -1, (0, 255, 0), 2)\
 \
            # Bounding rectangle\
            x, y, w, h = cv2.boundingRect(c)\
            cv2.rectangle(output, (x, y), (x + w, y + h), (0, 255, 0), 2)\
 \
            # Center using image moments (centroid of the contour area)\
            M = cv2.moments(c)\
            if M["m00"] != 0:\
                cx, cy = int(M["m10"] / M["m00"]), int(M["m01"] / M["m00"])\
            else:\
                cx, cy = x + w // 2, y + h // 2\
            cv2.circle(output, (cx, cy), 5, (0, 0, 255), -1)\
            cv2.putText(output, f"(\{cx\},\{cy\})", (cx + 8, cy - 8),\
                        cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 0, 255), 1)\
 \
        cv2.putText(output, f"Moving regions: \{significant\}", (10, 25),\
                    cv2.FONT_HERSHEY_SIMPLEX, 0.7, (255, 255, 255), 2)\
 \
        cv2.imshow("Motion", output)\
        cv2.imshow("Background", background)\
        cv2.imshow("Difference", gray_diff)\
        cv2.imshow("Binary", binary)\
        cv2.imshow("Contours", contour_vis)\
 \
        key = cv2.waitKey(1) & 0xFF\
        if key in (ord("q"), 27):\
            break\
        if key == ord("r"):\
            avg = None  # rebuild the background from the next frame\
